# Regenerated by tauri-build on every compile, as the Tauri v2 template
# ignores them; capabilities/default.json points at the desktop one only so an
# editor can validate the file.
/gen/schemas

# tauri icon writes an iOS set although no iOS target exists
icons/ios/

# Generated by build.rs from TAM_CONTROL_PLANE for a phone development build
/capabilities/dev-plane.json
