{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Teachouse",
  "version": "0.3.4",
  "identifier": "io.teachouse.desktop",
  "build": {
    "frontendDist": "../../../web/build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Teachouse",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://teachouse.stowiq.io"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "createUpdaterArtifacts": false,
    "publisher": "Teachouse",
    "category": "Business",
    "shortDescription": "Create once. Sell everywhere.",
    "longDescription": "Teachouse cross-lists your teaching resources to the marketplaces you sell on. Marketplace work for Tes and TPT runs on your own device."
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://cdn.crabnebula.app/update/teachouse/teachouse/{{target}}-{{arch}}/{{current_version}}?channel=beta"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxNTY3NUM5QUI2NjlGQ0MKUldUTW4yYXJ5WFZXMGFUbWpHdEhZWmgvUkc0Z2w4b0hEZTdCbllVOW5xRWxNMEs4Z1dqeXFKK0gK"
    }
  }
}
