{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "console",
  "description": "The main window's application commands, allowed for the configured production origin and local development content. Keep remote.urls aligned with control_plane::DEFAULT_BASE_URL. Marketplace login windows receive no grant.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://teachouse.io"
    ]
  },
  "permissions": [
    "allow-connect-marketplace",
    "allow-session-status",
    "allow-forget-session",
    "allow-device-check-in",
    "allow-device-activity",
    "allow-start-import",
    "allow-continue-import",
    "allow-stop-import",
    "allow-set-theme",
    "allow-library-entries",
    "allow-library-usage",
    "allow-library-read",
    "allow-library-remove",
    "allow-library-settings",
    "allow-set-library-settings",
    "allow-library-open-external"
  ]
}
