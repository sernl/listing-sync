---
import { supportEmail } from '../site.js';

const year = new Date().getFullYear();
---

<footer class="site-foot">
	<div class="wrap">
		<div class="cols">
			<div>
				<div class="wordmark">
					<img class="leaf" src="/favicon.svg" alt="" width="26" height="26" /> Teachouse
				</div>
				<p class="tagline">One catalogue, both marketplaces you sell on.</p>
			</div>
			<nav aria-label="Footer">
				<a href="/#how">How it works</a>
				<a href="/pricing/">Pricing</a>
				<a href="/#migrations">Migrations</a>
				<a href="/#faq">Questions</a>
				<a href="/privacy/">Privacy</a>
				<a href="/terms/">Terms</a>
				{supportEmail && <a href={`mailto:${supportEmail}`}>{supportEmail}</a>}
			</nav>
		</div>
		<p class="fine">
			TPT and TES are the trade names of their own companies. Teachouse is an independent tool,
			is not affiliated with either of them, and neither of them endorses it.
		</p>
		<p class="fine legal">
			<span>&copy; {year} Teachouse</span>
			<span>Auckland 1072, New Zealand</span>
			<a href="/">Powered by PLE Group</a>
		</p>
	</div>
</footer>
