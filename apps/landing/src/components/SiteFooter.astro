---
import { supportEmail } from '../site.js';

const year = new Date().getFullYear();
---

<footer class="site-foot">
	<div class="wrap">
		<div class="cols">
			<div>
				<div class="wordmark"><span class="leaf" aria-hidden="true">T</span> Teachouse</div>
				<p style="margin:10px 0 0">One catalogue, every marketplace you sell on.</p>
			</div>
			<nav aria-label="Footer">
				<a href="/#how">How it works</a>
				<a href="/#pricing">Pricing</a>
				<a href="/privacy/">Privacy</a>
				<a href="/terms/">Terms</a>
				<a href={`mailto:${supportEmail}`}>{supportEmail}</a>
			</nav>
		</div>
		<p class="fine">
			TeachersPayTeachers, Tes and Etsy are the trade names of their own companies. Teachouse is
			an independent tool, is not affiliated with any of them, and none of them endorses it.
		</p>
		<p class="fine">&copy; {year} Teachouse.</p>
	</div>
</footer>
