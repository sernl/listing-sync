---
import { supportEmail } from '../site.js';

const year = new Date().getFullYear();
---

<footer class="site-foot">
	<div class="wrap">
		<div class="cols">
			<div>
				<div class="wordmark">
					<img class="on-light" src="/brand/wordmark.svg" alt="Teachouse" width="132" height="32" loading="lazy" decoding="async" />
					<img class="on-dark" src="/brand/wordmark-dark.svg" alt="" width="132" height="32" loading="lazy" decoding="async" />
				</div>
				<p class="tagline">Create once. Sell everywhere.</p>
			</div>
			<nav aria-label="Footer">
				<a href="/#how">How it works</a>
				<a href="/pricing/">Pricing</a>
				<a href="/#about">About</a>
				<a href="/#resources">Resources</a>
				<a href="/privacy/">Privacy</a>
				<a href="/terms/">Terms</a>
				<a href={`mailto:${supportEmail}`}>{supportEmail}</a>
			</nav>
		</div>
		<p class="fine">
			Marketplace names and logos belong to their own companies. Teachouse is an independent
			tool, is not affiliated with any of them, and none of them endorses it.
		</p>
		<p class="fine legal">
			<span>&copy; {year} Teachouse</span>
			<a href="/">Powered by PLE Group</a>
		</p>
	</div>
</footer>
