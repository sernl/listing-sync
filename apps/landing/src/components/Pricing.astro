---
import Tick from './Tick.astro';
import { loginUrl, supportEmail } from '../site.js';
import {
	dollars,
	FOUNDING,
	importLadder,
	importLadderNote,
	planFeatures,
	rungCap,
	rungPrice,
	subscription,
	subscriptionCadence
} from '../pricing.js';

/* The two ways to start, and the founding offer beside them. One component
   draws both `/` and `/pricing`: `detail` is what the fuller page adds, which
   is the subscription's own figures and a join button in place of the link to
   itself. Every number comes from the server's plan table by way of
   `src/pricing.js`, and the one plan that table holds unsold (`studio`) is
   rendered nowhere. */

const { level = 2, detail = false } = Astro.props;
const Heading = level === 1 ? 'h1' : 'h2';

/* The open rung is an invitation rather than a band, so it is the one rung a
   reader can act on. It reaches the founder where there is an address to
   reach, and the founding section where there is not: `supportEmail` is null
   until the founder monitors one, and a `mailto:` that reaches nobody is
   worse than a link into the page. */
const askHref = supportEmail ? `mailto:${supportEmail}` : '/pricing/#founding';
---

<section class="section band-pricing" id="pricing">
	<div class="wrap">
		<p class="eyebrow">Simple, transparent pricing</p>
		<Heading>Two ways to get started</Heading>

		<div class="ways">
			<div class="way">
				<h3>1. Catalogue Import <span class="cadence">(one-off)</span></h3>
				<p>Bring your existing catalogue from your current marketplace into Teachouse.</p>
				<div class="ladder">
					{
						importLadder.map((rung) =>
							rung.price_cents === undefined ? (
								<a class="rung ask" href={askHref}>
									<span class="cap">{rungCap(rung)}</span>
									<span class="amount">{rungPrice(rung)}</span>
								</a>
							) : (
								<div class="rung">
									<span class="cap">{rungCap(rung)}</span>
									<span class="amount">{rungPrice(rung)}</span>
								</div>
							)
						)
					}
				</div>
				<p class="counts">{importLadderNote}</p>
			</div>

			<div class="way">
				<h3>2. {subscription.name} <span class="cadence">({subscriptionCadence})</span></h3>
				<p>Manage, update and distribute your catalogue across multiple marketplaces.</p>
				{/* A tick beside a line that is not built yet would claim it is.
				    The one coming-soon line takes a hollow mark instead. */}
				<div class="chips">
					{
						planFeatures(subscription).map((feature) => (
							<span class="chip">
								{
									feature.soon ? (
										<span class="tick soon" aria-hidden="true">
											<svg width="8" height="8" viewBox="0 0 8 8" aria-hidden="true">
												<circle cx="4" cy="4" r="3" fill="currentColor" />
											</svg>
										</span>
									) : (
										<Tick />
									)
								}
								{feature.text}
							</span>
						))
					}
				</div>
				{
					detail && (
						<p class="price">
							{dollars(subscription.monthly_cents)}
							<span class="per"> a month, or {dollars(subscription.yearly_cents)} a year</span>
						</p>
					)
				}
				<div class="actions">
					{
						detail ? (
							<a class="cta" href={loginUrl}>Join the Founding 100</a>
						) : (
							<a class="cta" href="/pricing/">View full pricing</a>
						)
					}
				</div>
			</div>

			<div class="founding" id="founding">
				<div class="head">
					<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M3.4 7.4l4.3 3.3L12 4.8l4.3 5.9 4.3-3.3-1.6 8.8H5z" />
						<path d="M5 19.2h14" />
					</svg>
					<h3>Founding 100</h3>
				</div>
				<ul>
					<li><strong>{FOUNDING.discount_year_one_pct}% off Year 1</strong></li>
					<li>{FOUNDING.discount_ongoing_pct}% off for {FOUNDING.ongoing_years} years after</li>
					<li>First {FOUNDING.free_imports} resources imported free</li>
					<li>Only {FOUNDING.places} places available.</li>
				</ul>
				<a class="btn" href={detail ? loginUrl : '/pricing/#founding'}>
					{detail ? 'Join the Founding 100' : 'Learn more'}
				</a>
			</div>
		</div>
	</div>
</section>
