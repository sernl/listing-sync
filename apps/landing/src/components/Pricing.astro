---
import Tick from './Tick.astro';
import {
	bestYearlyPercent,
	cardHighlights,
	cell,
	comparison,
	dollars,
	featuredPack,
	moveDefinition,
	moveExplained,
	packRows,
	perMonthYearly,
	plans,
	signupUrl,
	yearlySaving
} from '../pricing.js';

/* Good, better, best: the free plan and the three paid plans as four cards,
   the recommended one raised, the full comparison as a table under them, and
   the one-off packs as a strip at the foot. One component draws both `/` and
   `/pricing`; `level` is only which heading rank the section takes on its
   page. Every number, tagline and the recommended plan come from the
   server's plan table by way of `src/pricing.js`.

   The monthly/yearly switch is two native radio inputs, and the stylesheet
   shows one cadence's figures with `:has()`, so it needs no script, reads as
   a radio group to a screen reader and works from the keyboard. Yearly is
   checked in the markup, so it is the default. */

const { level = 2 } = Astro.props;
const Heading = level === 1 ? 'h1' : 'h2';
/* The plan, comparison and pack headings rank one under the section's own,
   so a page's outline never skips a level; `.rank-sub` draws them alike at
   either rank. */
const Sub = level === 1 ? 'h2' : 'h3';
---

<section class="section band-pricing" id="pricing">
	<div class="wrap">
		<p class="eyebrow">Simple, transparent pricing</p>
		<Heading>Plans for every shop</Heading>
		{/* A sale is data an operator saves, and this page is built ahead of
		    it: the banner is drawn hidden and `sale.js` fills and shows it,
		    striking the prices below, when `/v1/plans` answers one. */}
		<p class="sale-banner" data-sale-banner hidden>
			<strong data-sale-text></strong>
			<a data-sale-link href="/pricing">See the plans</a>
		</p>
		{/* What a move is, in a box above the cards so every figure below can
		    count in moves: one sentence, the rest behind Explain. The founder's
		    own example names two marketplaces, so the box is a marked band for
		    `just landing-copy-gate`. */}
		<div class="move-box" data-marketplace-band>
			<p><strong>What is a move?</strong> {moveDefinition}</p>
			<details class="move-explain">
				<summary>Explain</summary>
				{moveExplained.map((line) => <p>{line}</p>)}
			</details>
		</div>

		<fieldset class="billing">
			<legend class="sr-only">Billing period</legend>
			<input type="radio" name="billing" id="billing-yearly" value="yearly" checked />
			<label for="billing-yearly">
				Yearly <span class="billing-save">save up to {bestYearlyPercent}%</span>
			</label>
			<input type="radio" name="billing" id="billing-monthly" value="monthly" />
			<label for="billing-monthly">Monthly</label>
		</fieldset>

		<div class="tiers">
			{
				plans.map((plan) => {
					const { base, lines } = cardHighlights(plan);
					const paid = plan.yearly_cents !== null;
					return (
						<article
							class:list={['tier', { recommended: plan.recommended }]}
							aria-labelledby={`tier-${plan.id}`}
						>
							{plan.recommended && <p class="tier-badge">Recommended</p>}
							<Sub class="rank-sub" id={`tier-${plan.id}`}>{plan.name}</Sub>
							<p class="tier-tagline">{plan.tagline}</p>
							{paid ? (
								<>
									<div class="tier-price yearly-only">
										<p class="price">
											<span data-list-cents={plan.yearly_cents} data-per="12">
												{dollars(perMonthYearly(plan))}
											</span>
											<span class="per"> a month</span>
										</p>
										<p class="tier-note">
											Billed yearly,{' '}
											<span data-list-cents={plan.yearly_cents}>{dollars(plan.yearly_cents)}</span>
											<span class="tier-save" data-sale-hide>
												{' '}
												&middot; save {dollars(yearlySaving(plan))} a year
											</span>
										</p>
									</div>
									<div class="tier-price monthly-only">
										<p class="price">
											<span data-list-cents={plan.monthly_cents}>{dollars(plan.monthly_cents)}</span>
											<span class="per"> a month</span>
										</p>
										<p class="tier-note">Billed monthly, cancel any time</p>
									</div>
								</>
							) : (
								<div class="tier-price">
									<p class="price">
										$0<span class="per"> for as long as you like</span>
									</p>
									<p class="tier-note">No card needed</p>
								</div>
							)}
							<div class="tier-actions">
								{paid ? (
									<>
										<a
											class:list={[plan.recommended ? 'cta' : 'btn', 'yearly-only']}
											href={signupUrl(plan.yearly_key)}
										>
											Choose {plan.name}
										</a>
										<a
											class:list={[plan.recommended ? 'cta' : 'btn', 'monthly-only']}
											href={signupUrl(plan.monthly_key)}
										>
											Choose {plan.name}
										</a>
									</>
								) : (
									<a class="btn" href={signupUrl()}>
										Start free
									</a>
								)}
							</div>
							{base !== null && <p class="tier-base">Everything in {base}, plus:</p>}
							<ul class="tier-list">
								{lines.map((line) => (
									<li>
										<Tick />
										{line}
									</li>
								))}
							</ul>
						</article>
					);
				})
			}
		</div>

		<Sub class="rank-sub compare-title" id="compare-title">Compare the plans</Sub>
		{/* A region with a name and a tab stop, so a keyboard user can scroll
		    the table sideways on a phone; the feature column stays pinned. */}
		<div class="compare-wrap" role="region" aria-labelledby="compare-title" tabindex="0">
			<table class="compare">
				<thead>
					<tr>
						<th scope="col"><span class="sr-only">Feature</span></th>
						{
							plans.map((plan) => (
								<th scope="col" class:list={{ recommended: plan.recommended }}>
									{plan.name}
								</th>
							))
						}
					</tr>
				</thead>
				{
					comparison.map((group) => (
						<tbody>
							<tr class="compare-group">
								<th scope="colgroup" colspan={plans.length + 1}>
									{group.label}
								</th>
							</tr>
							{group.rows.map((feature) => (
								<tr>
									<th scope="row">
										{feature.label}
										{feature.soon && <span class="soon-tag">Coming soon</span>}
									</th>
									{plans.map((plan) => {
										const shown = cell(feature, plan);
										return (
											<td class:list={{ recommended: plan.recommended }}>
												{shown.kind === 'yes' && (
													<>
														<Tick />
														<span class="sr-only">{shown.label}</span>
													</>
												)}
												{shown.kind === 'soon' && (
													<>
														<span class="tick soon" aria-hidden="true" />
														<span class="sr-only">{shown.label}</span>
													</>
												)}
												{shown.kind === 'no' && (
													<>
														<span class="dash" aria-hidden="true">
															&ndash;
														</span>
														<span class="sr-only">{shown.label}</span>
													</>
												)}
												{shown.kind === 'text' && shown.text}
											</td>
										);
									})}
								</tr>
							))}
						</tbody>
					))
				}
			</table>
		</div>

		<div class="packs-strip">
			<div class="packs-copy">
				<Sub class="rank-sub">Move Packs <span class="cadence">(one-off)</span></Sub>
				<p>Moving your shop once? Buy the moves you need, on any plan, with no subscription. Pack moves last 12 months.</p>
				<a class="btn" href={signupUrl(featuredPack.key)}>Buy a pack</a>
			</div>
			<table class="packs">
				<colgroup>
					<col class="packs-moves" />
					<col />
					<col />
				</colgroup>
				<thead>
					<tr>
						<th scope="col">Moves</th>
						<th scope="col" class="num">Price</th>
						<th scope="col" class="num">Per move</th>
					</tr>
				</thead>
				<tbody>
					{
						packRows.map((pack) => (
							<tr>
								<th scope="row">{pack.moves}</th>
								<td class="num">{pack.price}</td>
								<td class="num unit">{pack.perMove}</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</div>
</section>

<script>
	/* `dollars` comes from `sale.js` rather than `pricing.js`, so the
	   browser bundle does not carry the generated plan table. */
	import { dollars, loadSale } from '../sale.js';

	const section = document.getElementById('pricing');
	if (section) void loadSale(section, dollars);
</script>
