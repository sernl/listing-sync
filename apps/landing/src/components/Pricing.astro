---
import Tick from './Tick.astro';
import {
	dollars,
	featuredPack,
	free,
	leadPlan,
	moveDefinition,
	packEditNote,
	packRows,
	paidPlans,
	perMonthYearly,
	planFeatures,
	planPitch,
	signupUrl
} from '../pricing.js';

/* The free plan, the three paid plans, and the one-off packs under them. One
   component draws both `/` and `/pricing`, which carry the same price list;
   `level` is only which heading rank the section takes on its page. Every
   number comes from the server's plan table by way of `src/pricing.js`. */

const { level = 2 } = Astro.props;
const Heading = level === 1 ? 'h1' : 'h2';
---

<section class="section band-pricing" id="pricing">
	<div class="wrap">
		<p class="eyebrow">Simple, transparent pricing</p>
		<Heading>Plans for every shop</Heading>
		{/* The founder's own example names two marketplaces, so the line is a
		    marked band for `just landing-copy-gate`. */}
		{/* A sale is data an operator saves, and this page is built ahead of
		    it: the banner is drawn hidden and `sale.js` fills and shows it,
		    striking the prices below, when `/v1/plans` answers one. */}
		<p class="sale-banner" data-sale-banner hidden>
			<strong data-sale-text></strong>
			<a data-sale-link href="/pricing">See the plans</a>
		</p>
		<p class="move-def" data-marketplace-band><strong>What is a move?</strong> {moveDefinition}</p>

		<div class="ways">
			<div class="way">
				<h3>{free.name} <span class="cadence">(trial)</span></h3>
				<p>Bring your shops in and try {free.capabilities.free_moves_lifetime} moves.</p>
				<p class="price">Free<span class="per"> for as long as you like</span></p>
				<div class="chips">
					{
						planFeatures(free).map((feature) => (
							<span class="chip">
								<Tick />
								{feature.text}
							</span>
						))
					}
				</div>
				<div class="actions">
					<a class="btn" href={signupUrl()}>Start free</a>
				</div>
			</div>

			{
				paidPlans.map((plan) => (
					<div class:list={['way', { lead: plan.id === leadPlan }]}>
						<h3>
							{plan.name} <span class="cadence">(subscription)</span>
						</h3>
						<p>{planPitch[plan.id]}</p>
						<p class="price">
							<span data-list-cents={plan.yearly_cents} data-per="12">
								{dollars(perMonthYearly(plan))}
							</span>
							<span class="per"> a month, billed yearly</span>
						</p>
						<p class="counts">
							<span data-list-cents={plan.monthly_cents}>{dollars(plan.monthly_cents)}</span> a
							month if you pay monthly.
						</p>
						{/* A tick beside a line that is not built yet would claim it is.
						    The one coming-soon line takes a hollow mark instead. */}
						<div class="chips">
							{planFeatures(plan).map((feature) => (
								<span class="chip">
									{feature.soon ? (
										<span class="tick soon" aria-hidden="true">
											<svg width="8" height="8" viewBox="0 0 8 8" aria-hidden="true">
												<circle cx="4" cy="4" r="3" fill="currentColor" />
											</svg>
										</span>
									) : (
										<Tick />
									)}
									{feature.text}
								</span>
							))}
						</div>
						<div class="actions">
							<a class={plan.id === leadPlan ? 'cta' : 'btn'} href={signupUrl(plan.yearly_key)}>
								Choose {plan.name}
							</a>
						</div>
					</div>
				))
			}
		</div>

		<div class="way packs-way">
			<div class="packs-copy">
				<h3>Move Packs <span class="cadence">(one-off)</span></h3>
				<p>Moving your shop once? Buy the moves you need, on any plan, with no subscription.</p>
				<p class="counts">{packEditNote} Pack moves last 12 months.</p>
				<div class="actions">
					<a class="btn" href={signupUrl(featuredPack.key)}>Buy a pack</a>
				</div>
			</div>
			<table class="packs">
				<thead>
					<tr>
						<th scope="col">Moves</th>
						<th scope="col">Price</th>
						<th scope="col">Per move</th>
					</tr>
				</thead>
				<tbody>
					{
						packRows.map((pack) => (
							<tr>
								<th scope="row">{pack.moves}</th>
								<td>{pack.price}</td>
								<td class="unit">{pack.perMove}</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</div>
</section>

<script>
	import { dollars } from '../pricing.js';
	import { loadSale } from '../sale.js';

	const section = document.getElementById('pricing');
	if (section) void loadSale(section, dollars);
</script>
