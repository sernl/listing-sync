---
import Tick from './Tick.astro';
import {
	dollars,
	featuredPack,
	FOUNDING,
	foundingCloses,
	foundingOpen,
	free,
	moveWithMe,
	moveDefinition,
	packEditNote,
	packRows,
	planFeatures,
	signupUrl,
	subscription,
	subscriptionPerMonth
} from '../pricing.js';

/* The three ways to start, the founding offer under them, and the one service
   sold beside them. One component draws both `/` and `/pricing`, which carry
   the same price list; `level` is only which heading rank the section takes on
   its page. Every number comes from the server's plan table by way of
   `src/pricing.js`, and the one plan that table holds unsold (`studio`) is
   rendered nowhere. */

const { level = 2 } = Astro.props;
const Heading = level === 1 ? 'h1' : 'h2';
---

<section class="section band-pricing" id="pricing">
	<div class="wrap">
		<p class="eyebrow">Simple, transparent pricing</p>
		<Heading>Three ways to start</Heading>
		{/* The founder's own example names two marketplaces, so the line is a
		    marked band for `just landing-copy-gate`. */}
		<p class="move-def" data-marketplace-band><strong>What is a move?</strong> {moveDefinition}</p>

		<div class="ways">
			<div class="way">
				<h3>{free.name} <span class="cadence">(Trial)</span></h3>
				<p>Bring your shops in and try {free.capabilities.free_moves_lifetime} moves.</p>
				<p class="price">Free<span class="per"> for as long as you like</span></p>
				<div class="chips">
					{
						planFeatures(free).map((feature) => (
							<span class="chip">
								<Tick />
								{feature.text}
							</span>
						))
					}
				</div>
				<div class="actions">
					<a class="btn" href={signupUrl()}>Start free</a>
				</div>
			</div>

			<div class="way lead">
				<h3>{subscription.name} <span class="cadence">(Subscription)</span></h3>
				<p>For teachers who add resources often. Keep every shop up to date.</p>
				<p class="price">
					{dollars(subscriptionPerMonth)}<span class="per"> a month, billed yearly</span>
				</p>
				<p class="counts">
					{dollars(subscription.monthly_cents)} a month if you pay monthly.
				</p>
				{/* A tick beside a line that is not built yet would claim it is.
				    The one coming-soon line takes a hollow mark instead. */}
				<div class="chips">
					{
						planFeatures(subscription).map((feature) => (
							<span class="chip">
								{
									feature.soon ? (
										<span class="tick soon" aria-hidden="true">
											<svg width="8" height="8" viewBox="0 0 8 8" aria-hidden="true">
												<circle cx="4" cy="4" r="3" fill="currentColor" />
											</svg>
										</span>
									) : (
										<Tick />
									)
								}
								{feature.text}
							</span>
						))
					}
				</div>
				<div class="actions">
					<a class="cta" href={signupUrl('sync_yearly')}>Start Sync</a>
				</div>
			</div>

			<div class="way">
				<h3>Move Packs <span class="cadence">(One-Off)</span></h3>
				<p>Moving your shop once? Buy the moves you need, with no subscription.</p>
				<table class="packs">
					<thead>
						<tr>
							<th scope="col">Moves</th>
							<th scope="col">Price</th>
							<th scope="col">Per move</th>
						</tr>
					</thead>
					<tbody>
						{
							packRows.map((pack) => (
								<tr>
									<th scope="row">{pack.moves}</th>
									<td>{pack.price}</td>
									<td class="unit">{pack.perMove}</td>
								</tr>
							))
						}
					</tbody>
				</table>
				<p class="counts">{packEditNote}</p>
				<div class="actions">
					<a class="btn" href={signupUrl(featuredPack.key)}>Buy a pack</a>
				</div>
			</div>
		</div>

		{
			foundingOpen && (
				<div class="founding" id="founding">
					<div class="head">
						<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M3.4 7.4l4.3 3.3L12 4.8l4.3 5.9 4.3-3.3-1.6 8.8H5z" />
							<path d="M5 19.2h14" />
						</svg>
						<h3>Founding {FOUNDING.places}</h3>
					</div>
					<ul>
						<li>
							<strong>{dollars(FOUNDING.year_one_cents)} for your first year</strong>
						</li>
						<li>
							{dollars(FOUNDING.ongoing_cents)} a year through year {FOUNDING.ongoing_years}
						</li>
						<li>{FOUNDING.extra_moves} moves on top</li>
						<li>
							{FOUNDING.annual_only ? 'Annual only. ' : ''}Closes at {FOUNDING.places} members or on{' '}
							{foundingCloses}.
						</li>
					</ul>
					<a class="btn" href={signupUrl('founding_yearly')}>
						Join the Founding {FOUNDING.places}
					</a>
				</div>
			)
		}

		<p class="service">
			<span class="service-name">{moveWithMe.name}</span>
			<span class="service-price">{dollars(moveWithMe.price_cents)}</span>
			<span class="service-copy">Book a session and we do your move with you.</span>
			<a class="link" href={signupUrl(moveWithMe.key)}>Book a session</a>
		</p>
	</div>
</section>
