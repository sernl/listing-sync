---
import { loginUrl } from '../site.js';

/* About points at the challenge section and Resources at the marketplace strip,
   because neither has a page of its own. */
---

<header class="site-head">
	<div class="wrap">
		<a class="wordmark" href="/">
			<img src="/brand/wordmark.svg" alt="Teachouse" height="32" />
		</a>
		<nav class="site-nav" aria-label="Primary">
			<a href="/#how">How it works</a>
			<a href="/pricing/">Pricing</a>
			<a href="/#about">About</a>
			<a href="/#resources">Resources</a>
			<a class="btn" href={loginUrl}>Log in</a>
			<a class="cta" href="/pricing/#founding">Join the Founding 100</a>
		</nav>
	</div>
</header>
