---
import { loginUrl } from '../site.js';
import { migrationBands, migrationRules } from '../pricing.js';
---

<section class="section" id="migrations">
	<div class="wrap">
		<h2>Move a shop across in one go</h2>
		<p class="lede">
			If everything you sell is already in one shop, a migration puts it in another one as a
			single piece of work, at a fixed price quoted before we start.
		</p>
		<div class="panel">
			<div class="bands">
				{
					migrationBands.map((band) => (
						<div class="band">
							<span class="size">{band.size}</span>
							<span class="cost">{band.price}</span>
						</div>
					))
				}
			</div>
			<ul class="rules">
				{migrationRules.map((rule) => <li>{rule}</li>)}
			</ul>
			<a class="cta" href={loginUrl}>Start free and ask for a quote</a>
		</div>
	</div>
</section>
