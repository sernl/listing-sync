---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import MarketplaceBand from '../components/MarketplaceBand.astro';
import PlatformRow from '../components/PlatformRow.astro';
import Pricing from '../components/Pricing.astro';
import Testimonials from '../components/Testimonials.astro';
import MarkTile from '../components/MarkTile.astro';
import ResourceCover from '../components/ResourceCover.astro';
import { markSlot } from '../art.js';
import { marks } from '../marketplaces.js';
import { signupUrl } from '../pricing.js';
import { faqPage, softwareApplication } from '../seo.js';
import { availability, homeTitle } from '../site.js';

/* The search result: the title names what connects today, and the
   description ends on the availability sentence itself, so neither says
   anything about marketplaces the copy gate has not already been told. */
const title = homeTitle;
const description = `One catalogue for your teaching resources, published everywhere you sell. ${availability}`;
const structuredData = [softwareApplication(Astro.site, description), faqPage()];

/* The hero's composition routes the catalogue out to four marks, read from
   the same list the strip under the buttons draws so the drawing cannot name
   a fifth marketplace or quietly drop one. The marks are `<image>`
   references to their owners' own published bytes, never a redrawing, which
   is the rule the strip already works under.

   Geometry lives here rather than in the markup: four tiles, their routing
   lines and the slot a mark sits in are arithmetic, and arithmetic repeated
   four times by hand is where a composition drifts. */
const routes = marks.filter((mark) => mark.featured);

const TILE = { w: 100, h: 58 };
const wideTiles = [22, 108, 194, 280];
const phoneTiles = [
	{ x: 22, y: 240 },
	{ x: 186, y: 240 },
	{ x: 22, y: 304 },
	{ x: 186, y: 304 }
];

const steps = [
	{ h: 'Import', p: 'Your catalogue' },
	{ h: 'Distribute', p: 'To multiple marketplaces' },
	{ h: 'Manage', p: 'Update and grow' }
];
---

<Base title={title} description={description} structuredData={structuredData}>
	<section class="hero">
		<div class="wrap hero-grid">
			<div>
				<p class="eyebrow">The home for teacher creators</p>
				<h1>Create once.<br />Sell everywhere.</h1>
				<p class="sell">
					Teachouse helps you cross-list and manage your teacher resources across multiple
					marketplaces &mdash; all from one place.
				</p>
				<div class="actions">
					<a class="cta large" href={signupUrl()} data-cta="hero">Start free</a>
					<a class="btn large" href="#how">See how it works</a>
				</div>
				<MarketplaceBand />
			</div>

			{/* The Resource Atelier: the seller's own covers in one catalogue
			    card, and quiet teal lines routing them out to the marketplaces
			    that sell them. Everything but the four marks is drawn, so the
			    composition costs no photograph and reads on either ground.

			    Two drawings rather than one reflowed: under 720px there is
			    room for one cover and a 2x2 grid, and hiding half of a
			    composition leaves a hole where the other half was. */}
			<div class="hero-art" data-marketplace-band>
				<svg class="atelier atelier-wide" viewBox="0 0 560 400" role="img" aria-labelledby="atelier-wide-title">
					<title id="atelier-wide-title">
						One catalogue of resource covers, routed out to TPT, Tes, Classful, Teach Simple and more
					</title>
					{
						wideTiles.map((top) => (
							<path
								class="route"
								d={`M320 165C374 165 390 ${top + TILE.h / 2} 444 ${top + TILE.h / 2}`}
							/>
						))
					}
					<rect x="8" y="54" width="312" height="198" rx="20" fill="var(--cream)" stroke="var(--art-line)" />
					<circle cx="320" cy="165" r="5" fill="var(--accent)" />
					<image href="/brand/house.svg" x="32" y="76" width="26" height="26" />
					<text class="art-display" x="68" y="96">Your catalogue</text>
					<ResourceCover x={32} y={126} rotate={-4} motif="fractions" backing="peach" />
					<ResourceCover x={122} y={126} motif="reading" />
					<ResourceCover x={212} y={126} rotate={4} motif="checklist" backing="lavender" />
					{
						routes.map((mark, index) => (
							<MarkTile mark={mark} x={444} y={wideTiles[index]} w={TILE.w} h={TILE.h} />
						))
					}
					<text class="art-sans" x="494" y="372" text-anchor="middle">+ more</text>
				</svg>

				<svg class="atelier atelier-phone" viewBox="0 0 340 400" role="img" aria-labelledby="atelier-phone-title">
					<title id="atelier-phone-title">
						One catalogue of resources, routed out to TPT, Tes, Classful, Teach Simple and more
					</title>
					<path class="route" d="M170 196C170 214 88 216 88 240" />
					<path class="route" d="M170 196C170 214 252 216 252 240" />
					<path class="route" d="M170 196C120 210 8 228 8 330L22 330" />
					<path class="route" d="M170 196C220 210 332 228 332 330L318 330" />
					<rect x="20" width="300" height="186" rx="20" fill="var(--cream)" stroke="var(--art-line)" />
					<circle cx="170" cy="192" r="5" fill="var(--accent)" />
					<image href="/brand/house.svg" x="44" y="22" width="24" height="24" />
					<text class="art-display" x="78" y="41">Your catalogue</text>
					<ResourceCover x={132} y={64} rotate={-3} motif="fractions" backing="peach" />
					{
						routes.map((mark, index) => (
							<MarkTile mark={mark} x={phoneTiles[index].x} y={phoneTiles[index].y} w={132} h={52} />
						))
					}
					<text class="art-sans" x="170" y="384" text-anchor="middle">+ more</text>
				</svg>
			</div>
		</div>
	</section>

	<section class="section band-challenge" id="about">
		<div class="wrap split">
			<div class="copy">
				<p class="eyebrow">The challenge</p>
				<h2>You already did the hard part.</h2>
				<p>You created the resource. The planning, the design, the previews, the polish &mdash; done.</p>
				<p>
					Then the second job begins. Uploading the same files again. Rewriting the description.
					Re-entering the title. Redoing the keywords and tags. Reformatting everything for
					another marketplace&rsquo;s requirements.
				</p>
				<p>Then keeping every version up to date, forever.</p>
				<div class="quote">
					<p>&ldquo;I already created the resource.</p>
					<p>Why am I doing all this work again?&rdquo;</p>
				</div>
				<p class="closing-line">
					You became a teacherpreneur to create &mdash; not to copy and paste listings all day.
				</p>
			</div>
			{/* The second job, drawn: one finished cover on the left, then the
			    same title typed again on a listing sheet per marketplace. The
			    repetition is the point, so the three sheets are identical but
			    for the mark at the top of each. */}
			<figure class="art" data-marketplace-band>
				<svg class="atelier atelier-challenge" viewBox="0 0 540 360" role="img" aria-labelledby="challenge-art-title">
					<title id="challenge-art-title">
						One finished resource, then the same listing typed again for TPT, for Tes and for Classful
					</title>
					<g transform="translate(16 84) scale(1.6)">
						<ResourceCover motif="fractions" backing="peach" />
					</g>
					<circle cx="138" cy="92" r="16" fill="var(--accent)" />
					<path
						d="m131 92 5 5 9-10"
						fill="none"
						stroke="var(--on-fill)"
						stroke-width="2.6"
						stroke-linecap="round"
						stroke-linejoin="round"
					/>
					{
						routes.slice(0, 3).map((mark, index) => {
							const x = 190 + index * 26;
							const y = 20 + index * 88;
							return (
								<g>
									<rect
										x={x}
										y={y}
										width="260"
										height="76"
										rx="12"
										fill="var(--surface)"
										stroke="var(--art-line)"
									/>
									<rect
										x={x + 14}
										y={y + 14}
										width="62"
										height="28"
										rx="8"
										fill="var(--mark-ground)"
									/>
									<image
										href={`/marks/${mark.file}`}
										{...markSlot(mark, x + 14, y + 14, 62, 28)}
										preserveAspectRatio="xMidYMid meet"
									/>
									<text class="art-display art-sheet-title" x={x + 88} y={y + 33}>
										Fractions practice
									</text>
									<g fill="var(--primary)" opacity="0.26">
										<rect x={x + 88} y={y + 44} width="92" height="5" rx="2.5" />
										<rect x={x + 88} y={y + 56} width="66" height="5" rx="2.5" />
									</g>
									<rect
										x={x + 186}
										y={y + 46}
										width="58"
										height="20"
										rx="10"
										fill="var(--accent-soft)"
									/>
									<text class="art-sans art-sheet-pill" x={x + 215} y={y + 60} text-anchor="middle">
										Upload
									</text>
								</g>
							);
						})
					}
					<path
						class="bracket"
						d="M190 288v14h312v-14"
					/>
					<path class="bracket" d="M346 302v12" />
					<text class="art-display art-bracket-label" x="346" y="340" text-anchor="middle">
						Same resource. Repeated admin.
					</text>
				</svg>
			</figure>
		</div>
	</section>

	<section class="section band-solution" id="how">
		<div class="wrap split">
			<div class="copy">
				<p class="eyebrow">The solution</p>
				<h2>You don&rsquo;t need more resources. You need more from your resources.</h2>
				<p>
					Bring your existing catalogue into Teachouse, then cross-list, update and manage it
					across multiple marketplaces &mdash; all from one home.
				</p>
				{/* Lucide's download, share-2 and sliders-horizontal (ISC licence),
				    on its 24 grid at its own 2px stroke, so the three read as one
				    set at the tile's size. */}
				<div class="steps">
					{
						steps.map((step, index) => (
							<>
								{index > 0 && (
									<svg class="step-arrow" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<path d="M5 12h14" />
										<path d="m12 5 7 7-7 7" />
									</svg>
								)}
								<div class="step">
									<span class="glyph">
										<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
											{index === 0 && (
												<>
													<path d="M12 15V3" />
													<path d="m7 10 5 5 5-5" />
													<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
												</>
											)}
											{index === 1 && (
												<>
													<circle cx="18" cy="5" r="3" />
													<circle cx="6" cy="12" r="3" />
													<circle cx="18" cy="19" r="3" />
													<path d="m8.59 13.51 6.83 3.98" />
													<path d="m15.41 6.51-6.82 3.98" />
												</>
											)}
											{index === 2 && (
												<>
													<path d="M21 4h-7M10 4H3M21 12h-9M8 12H3M21 20h-5M12 20H3" />
													<path d="M14 2v4M8 10v4M16 18v4" />
												</>
											)}
										</svg>
									</span>
									<h3>{step.h}</h3>
									<p>{step.p}</p>
								</div>
							</>
						))
					}
				</div>
				<div class="actions">
					<a class="cta" href={signupUrl()} data-cta="closing">Start free</a>
					{/* The mockup's second button reads "See how it works", which is
					    this section; from here the useful next step is the price. */}
					<a class="link" href="#pricing">See pricing</a>
				</div>
			</div>
			{/* The small app some marketplace work needs, and why, in two
			    sentences. There is no download link here: the console's
			    Marketplaces page offers the build that fits the reader's device
			    once they are signed in, and the FAQ's app answer links there.
			    The reason names the two marketplaces because the reason is theirs:
			    the founder's feedback of 2026-09-30 asked for it said plainly, so
			    the sentence is a marketplace band to the copy gate. */}
			<aside class="download" aria-labelledby="download-title">
				<h3 id="download-title">The free Teachouse app</h3>
				<p data-marketplace-band>
					TPT and Tes have no official API, so the app signs in on your own device and your files
					stay there. Everything else works in your browser.
				</p>
				<PlatformRow />
			</aside>
		</div>

		{/* The proof, and the one photograph-shaped thing on the page: a
		    capture of the console's own Resources page with six sample
		    resources and the covers Teachouse drew from their PDFs, taken on
		    2026-09-27 in the light theme. It spans the whole measure under the
		    two columns above, so the covers and titles read at the size a
		    seller sees them, and it is framed rather than bled, because a
		    screenshot with no edge reads as part of the page rather than as
		    the product.

		    Two captures: the desktop one at 2x (1440 wide), and the 390
		    phone layout at 2x, because scaling the wide shot down to a phone
		    column makes the page unreadable. Each is shipped as AVIF, about
		    half the bytes, with the WebP it was encoded from as the fallback
		    for a browser without AVIF. Below the fold on every width, so lazy;
		    the hero carries no raster to prioritise. */}
		<div class="wrap">
			<figure class="console-shot">
				<div class="frame">
					<picture>
						<source
							media="(max-width: 720px)"
							srcset="/images/console-resources-phone.avif"
							type="image/avif"
							width="390"
							height="844"
						/>
						<source
							media="(max-width: 720px)"
							srcset="/images/console-resources-phone.webp"
							type="image/webp"
							width="390"
							height="844"
						/>
						<source srcset="/images/console-resources.avif" type="image/avif" width="1440" height="750" />
						<img
							src="/images/console-resources.webp"
							alt="The Teachouse Resources page listing six resources with their covers, such as Year 6 English, Persuasive writing unit and Grade 4 Math, Fractions practice, each with its price and where it is listed"
							width="1440"
							height="750"
							loading="lazy"
							decoding="async"
						/>
					</picture>
				</div>
				<figcaption>Your resources, together.</figcaption>
			</figure>
		</div>
	</section>

	<Pricing />
	<Testimonials />
	<Faq />
</Base>
