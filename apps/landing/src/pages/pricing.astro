---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import Pricing from '../components/Pricing.astro';

const title = 'Pricing \u2014 Teachouse';
const description =
	'Teachouse plans: Look is free with moves to try, Starter, Pro and Studio are subscriptions with moves every month, and one-off packs of moves work on any plan. Prices in US dollars.';
---

<Base title={title} description={description}>
	<Pricing level={1} />
	<Faq />
</Base>
