---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import Pricing from '../components/Pricing.astro';

const title = 'Pricing \u2014 Teachouse';
const description =
	'Three ways to start with Teachouse: a free plan with moves to try, a subscription with moves every month, and one-off packs of moves on any plan. Prices in US dollars.';
---

<Base title={title} description={description}>
	<Pricing level={1} />
	<Faq />
</Base>
