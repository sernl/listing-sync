---
import Base from '../layouts/Base.astro';
import { TERMS_VERSION } from '../legal.generated.js';
import { dollars, free, plans } from '../pricing.js';
import { supportEmail } from '../site.js';

/* The date the text below last changed in substance and took effect. It is
   TERMS_VERSION, which tam-typegen emits from the server's constant, and it is
   also the version every sign-up's agreement records, so the date printed
   here is the one a person agreed to. Moving it is part of changing the
   terms (crates/tam-api/src/account_consent.rs), asks every signed-in person
   to agree again, and section 20 says how a change is announced. */
const effective = new Date(`${TERMS_VERSION}T00:00:00Z`).toLocaleDateString('en-NZ', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
	timeZone: 'UTC'
});
const updated = effective;

/* Read from the plan table the server enforces, so the free plan's name and
   its one-off moves cannot drift from what the product actually gives. */
const freeName = free.name;
const freeMoves = free.capabilities.free_moves_lifetime;

/* The yearly refund in section 11, worked on Pro's yearly price from the same
   table: asking during the fourth month leaves 8 whole months unused, and one
   month's fee is kept, so 7 twelfths come back. */
const pro = plans.find((plan) => plan.id === 'subscriber');
const exampleMonth = 4;
const exampleUnused = 12 - exampleMonth;
const exampleYearly = dollars(pro.yearly_cents);
const exampleRefund = dollars(Math.max(0, (pro.yearly_cents * (exampleUnused - 1)) / 12));
---

<Base
	title="Terms of Service — Teachouse"
	description="The agreement between you and Teachouse: what the service is, what it is not, how plans and refunds work, and New Zealand law."
>
	<section class="section">
		<div class="wrap prose policy">
			<h1>Terms of Service</h1>
			<p class="policy-meta">Last updated {updated} · Effective {effective}</p>

			<p>
				These terms are the agreement between you and Teachouse. They cover the Teachouse website,
				the web console and the Teachouse app on your computer or phone. Each section starts with a
				one-line summary, and the questions people ask most are answered at the end.
			</p>
			<p>
				"Teachouse", "we" and "us" mean the business that runs Teachouse in New Zealand. "You" means
				the person who holds a Teachouse account, and anyone using Teachouse for them.
			</p>

			<nav class="policy-toc" aria-label="Sections of these terms">
				<ol>
					<li><a href="#agreement">Agreeing to these terms</a></li>
					<li><a href="#what">What Teachouse is</a></li>
					<li><a href="#not">What Teachouse is not</a></li>
					<li><a href="#account">Your account</a></li>
					<li><a href="#one-account">One person, one free account</a></li>
					<li><a href="#content">Your resources</a></li>
					<li><a href="#use">Using Teachouse fairly</a></li>
					<li><a href="#automated">Automated access</a></li>
					<li><a href="#free">The free plan</a></li>
					<li><a href="#billing">Plans, packs and payment</a></li>
					<li><a href="#refunds">Refunds</a></li>
					<li><a href="#marketplaces">Marketplaces we don't control</a></li>
					<li><a href="#changes-service">Changes and availability</a></li>
					<li><a href="#privacy">Your information</a></li>
					<li><a href="#security">Keeping your account safe</a></li>
					<li><a href="#ending">Ending your account</a></li>
					<li><a href="#law">New Zealand consumer law</a></li>
					<li><a href="#liability">What we're responsible for</a></li>
					<li><a href="#indemnity">What you're responsible for</a></li>
					<li><a href="#changes">Changes to these terms</a></li>
					<li><a href="#disputes">If something goes wrong between us</a></li>
					<li><a href="#contact">Contact</a></li>
					<li><a href="#questions">Questions people ask</a></li>
				</ol>
			</nav>

			<h2 id="agreement">1. Agreeing to these terms</h2>
			<p><strong>In short:</strong> using Teachouse means you agree to these terms.</p>
			<ul>
				<li>
					By creating an account or using Teachouse, you agree to these terms and to our{' '}
					<a class="link" href="/privacy/">Privacy Policy</a>.
				</li>
				<li>
					If you use Teachouse for a school, business or other organisation, you agree for it too,
					and you confirm you are allowed to.
				</li>
				<li>If you don't agree, please don't use Teachouse.</li>
			</ul>

			<h2 id="what">2. What Teachouse is</h2>
			<p>
				<strong>In short:</strong> a tool that helps teachers publish their resources and keep their
				listings in sync, using their own marketplace accounts from their own devices.
			</p>
			<ul>
				<li>
					Teachouse keeps one catalogue of your teaching resources and helps you publish, update
					and track them on the marketplaces where you sell.
				</li>
				<li>
					It acts inside your own marketplace accounts, and only on your own shop. For a marketplace
					with no official way for other services to connect, you sign in to that marketplace in
					the Teachouse app on your own device, and the marketplace work runs there.
				</li>
				<li>
					That work only runs while the Teachouse app is open and signed in on one of your devices.
					If none is open, it waits.
				</li>
				<li>
					Some decisions are yours alone, such as who holds the copyright in a resource or how it
					is treated for tax. Teachouse asks you and never fills them in for you.
				</li>
			</ul>

			<h2 id="not">3. What Teachouse is not</h2>
			<p>
				<strong>In short:</strong> we're independent of every marketplace, and we don't host or sell
				your resources.
			</p>
			<ul>
				<li>
					Teachouse is an independent tool. It is not made, owned, endorsed or sponsored by
					Teachers Pay Teachers, Tes, or any other marketplace it connects to. Their names appear
					here only to say what Teachouse works with.
				</li>
				<li>
					Your marketplace accounts are between you and each marketplace. Their terms and rules
					apply to those accounts, and nothing in these terms changes them.
				</li>
				<li>
					We are not a marketplace. We don't sell your resources, show them to buyers, take a share
					of your sales or handle your buyers' payments.
				</li>
				<li>
					Files you import from a marketplace stay on your own devices. When you open one in the
					console, it passes from your device through our servers to your browser without being
					kept. Files you upload to Teachouse yourself are stored for you, until you delete them.
				</li>
				<li>We are not your lawyer, accountant or tax adviser.</li>
			</ul>

			<h2 id="account">4. Your account</h2>
			<p>
				<strong>In short:</strong> you must be 18 or over, hold one account, and keep your sign-in to
				yourself.
			</p>
			<ul>
				<li>You must be at least 18 to create or use a Teachouse account.</li>
				<li>
					Each person may hold one Teachouse account. Section 5 says what happens to extra ones.
				</li>
				<li>Give us true details, and keep your email address up to date so our notices reach you.</li>
				<li>
					Your password and passkeys are for you. If you let someone help run your shop in your
					account, you are responsible for what they do there.
				</li>
			</ul>

			<h2 id="one-account">5. One person, one free account</h2>
			<p>
				<strong>In short:</strong> one free account per person and free moves once per shop. Extra
				accounts made to get more for free are abuse, and we can close them.
			</p>
			<ul>
				<li>
					Each person may hold one Teachouse account. The free moves come once, and never again for
					a shop that has had them, whichever account it is connected to. Each shop can be connected
					to only one Teachouse account at a time.
				</li>
				<li>
					It is abuse to create more than one account to get more free moves or previews, to share a
					shop between accounts or move it to a new one to get its free moves again, or to open an
					account to get around a limit or a suspension.
				</li>
				<li>
					To spot abuse we compare a few signals between accounts, such as hashed network addresses,
					device IDs, shop IDs and card fingerprints, as the{' '}
					<a class="link" href="/privacy/#abuse">Privacy Policy</a> describes. A person looks at
					every flag before we act on it.
				</li>
				<li>
					If we find abuse, we may warn you, remove free moves, stop new marketplace connections,
					or suspend or ban the account. A ban can cover the email address, the linked marketplace
					shops, the devices and the payment cards, and we may refuse them on any other account,
					including a new sign-up.
					<details class="explain">
						<summary>Explain</summary>
						<p>
							While an account is suspended, its moves and Move Packs are frozen. If we close it for
							abuse, its unused moves and Move Packs are forfeited, and section 11 doesn't apply to
							them unless the law says otherwise.
						</p>
						<p>
							We'll tell you what we found and why. If you think we got it wrong, reply to that
							email and we'll look again.
						</p>
					</details>
				</li>
			</ul>

			<h2 id="content">6. Your resources</h2>
			<p>
				<strong>In short:</strong> what you make stays yours. You let us handle it only to run
				Teachouse for you, and you promise you have the right to sell it.
			</p>
			<ul>
				<li>
					You keep every right you have in your resources, listings, images and descriptions. We
					claim no ownership of them.
				</li>
				<li>
					You give us a limited, non-exclusive, worldwide, royalty-free licence to store, copy,
					process and send your content only as needed to run Teachouse for you: to keep your
					catalogue, make previews and thumbnails you ask for, and publish to the marketplaces you
					choose. The licence ends when the content is deleted from Teachouse, apart from copies in
					backups, which are replaced within 12 months.
				</li>
				<li>
					We don't use your resources to advertise Teachouse, and we don't give them to anyone
					else, except the marketplaces you publish to.
				</li>
				<li>
					You promise that you own your content or have permission to publish and sell it, and
					that publishing it doesn't break anyone's rights or any law.
				</li>
				<li>
					You authorise Teachouse to act in your marketplace accounts as you ask, and you promise
					you are allowed to give that authority.
				</li>
				<li>
					If you think content stored on Teachouse infringes your rights, email us at{' '}
					<a class="link" href={`mailto:${supportEmail}`}>{supportEmail}</a> and we will look into it
					and remove it where that is right.
				</li>
			</ul>

			<h2 id="use">7. Using Teachouse fairly</h2>
			<p>
				<strong>In short:</strong> use Teachouse for your own shop, within the law and the
				marketplaces' rules.
			</p>
			<p>You must not use Teachouse to:</p>
			<ul>
				<li>collect, copy or scrape other sellers' listings, resources or data;</li>
				<li>
					get around a marketplace's rules or limits, such as its pricing rules, or act in a shop
					that isn't yours or that you aren't authorised to run;
				</li>
				<li>
					publish anything illegal, infringing, deceptive, hateful or harmful, or anything that
					isn't suitable for the teaching audience it is sold to;
				</li>
				<li>
					copy, reverse engineer or take apart Teachouse or the app, except as the law allows;
				</li>
				<li>
					probe, overload or break our systems or security, or reach data that isn't yours;
				</li>
				<li>resell Teachouse or build a competing service from it.</li>
			</ul>
			<p>
				Some marketplace rules are built into Teachouse as a step you must clear before publishing.
				That helps, but following each marketplace's rules is still your responsibility.
			</p>

			<h2 id="automated">8. Automated access</h2>
			<p>
				<strong>In short:</strong> Teachouse is for people. No scraping, no bots and no AI training,
				apart from our own app.
			</p>
			<p>You must not, and must not let anyone or anything else:</p>
			<ul>
				<li>
					scrape, crawl or bulk-download our website, the console or the API, or the listings of
					other sellers that Teachouse shows you;
				</li>
				<li>
					use anything from Teachouse, including our pages, guides and other sellers' listings, to
					train, fine-tune or feed an AI or machine-learning model, or to build a dataset;
				</li>
				<li>
					reach the console or the API with anything but the Teachouse app or an ordinary browser,
					such as bots, scripts, headless browsers or AI agents;
				</li>
				<li>
					use the API other than through the console and the Teachouse app, unless we have issued
					you an API key for it, and then only as that key allows;
				</li>
				<li>
					give your sign-in, session or API key to a tool, a service, or anyone who isn't helping you
					run your shop, or sell or lend access to your account.
				</li>
			</ul>
			<p>
				We may rate-limit, challenge or block automated traffic, and suspend or close an account
				that uses it (section 16). Our robots.txt and page tags say the same thing to crawlers.
			</p>

			<h2 id="free">9. The free plan</h2>
			<p>
				<strong>In short:</strong> {freeName} is free for as long as you like, within its limits.
			</p>
			<ul>
				<li>
					{freeName} costs nothing and has no end date. Its limits on resources, previews and other
					features are on the <a class="link" href="/pricing/">pricing page</a>.
				</li>
				<li>
					It includes {freeMoves} free moves, once, when your first shop connects. Connecting another
					shop, or moving a shop to a new account, does not add more.
				</li>
				<li>
					We may change what {freeName} includes. If we lower a limit, you keep everything you
					already have; you just can't add more until you are under the new limit or you upgrade.
				</li>
			</ul>

			<h2 id="billing">10. Plans, packs and payment</h2>
			<p>
				<strong>In short:</strong> prices are in US dollars, paid through Stripe. Plans renew until
				you cancel; packs are one-off.
			</p>
			<ul>
				<li>
					Prices are in US dollars (USD) and are shown on the{' '}
					<a class="link" href="/pricing/">pricing page</a> and in Account → Billing. Teachouse is
					the seller, and payment is taken by Stripe. Your card details go to Stripe, never to us.
				</li>
				<li>
					Any tax that applies, such as GST, is worked out at checkout and shown before you pay.
				</li>
				<li>
					<strong>Plans</strong> are billed monthly or yearly, in advance, and renew automatically
					at the end of each period until you cancel.
				</li>
				<li>
					You can <strong>cancel</strong> any time in Account → Billing. Your plan keeps working
					until the end of the period you have paid for and then doesn't renew. Until that day, you
					can change your mind with Keep my plan.
				</li>
				<li>
					You can <strong>switch plans</strong> any time. Stripe shows you the new price before
					anything changes.
				</li>
				<li>
					<strong>Move Packs</strong> are one-off purchases. Their moves last 12 months from the day
					you buy them and work on any plan.
				</li>
				<li>
					A plan's monthly moves build up to three months' worth, then stop adding. When a plan ends,
					it stops adding moves, and the moves you have stay yours until they expire.
				</li>
				<li>
					A move counts when a resource is published to a marketplace, whether it arrives as a draft
					or goes live. A publish that never arrives uses no move.
				</li>
				<li>
					Moves are not money. They have no cash value, can't be transferred or sold, and expire as
					described above.
				</li>
				<li>
					If a renewal payment fails, your paid features stop until it is paid. Nothing in your
					catalogue is deleted.
				</li>
				<li>
					Discount codes apply only as described when you use them, and have no cash value.
				</li>
				<li>
					We may change our prices. We will email you at least 30 days before a new price applies to
					you, and it starts from your next renewal after that. You can cancel before then.
				</li>
			</ul>

			<h2 id="refunds">11. Refunds</h2>
			<p>
				<strong>In short:</strong> an unused Move Pack is refunded in full within 14 days, a yearly
				plan is refunded for its unused whole months less one month's fee, and a monthly plan isn't
				refunded once its month has started.
			</p>
			<ul>
				<li>
					<strong>Move Packs:</strong> if you haven't used any moves from a Move Pack, you can ask
					for a full refund within 14 days of buying it.
				</li>
				<li>
					<strong>Monthly plans:</strong> a month that has started is not refunded. Cancelling
					stops the next renewal.
				</li>
				<li>
					<strong>Yearly plans:</strong> you can ask for a refund at any time during the year. We
					refund the whole months that haven't started yet and keep one month's fee. The plan ends
					on the day of the refund and your account moves to {freeName}.
					<details class="explain">
						<summary>Explain</summary>
						<p>
							The refund is the yearly price × (unused whole months − 1) ÷ 12, and never less than
							zero. A month counts as used once it has started. Months are counted in New Zealand
							time from the day your yearly plan started.
						</p>
						<p>
							For example, {pro.name} yearly costs {exampleYearly}. You ask for a refund during
							month {exampleMonth}, so months {exampleMonth + 1} to 12 are unused: {exampleUnused} whole
							months. We keep one month's fee, so the refund is {exampleUnused - 1} × {exampleYearly} ÷
							12 = {exampleRefund}.
						</p>
						<p>From month 11 onwards there is nothing left to refund.</p>
					</details>
				</li>
				<li>
					To ask for a refund, press Ask for a refund in Account → Billing, or email{' '}
					<a class="link" href={`mailto:${supportEmail}`}>{supportEmail}</a> from the address you
					sign in with and tell us what you bought and when. Refunds go back to the card you paid
					with.
				</li>
			</ul>

			<h2 id="marketplaces">12. Marketplaces we don't control</h2>
			<p>
				<strong>In short:</strong> marketplaces can change or block things at any time, so we can't
				promise every listing will publish or stay in sync.
			</p>
			<ul>
				<li>
					Marketplaces change their websites, rules and limits without telling us. When they do,
					publishing, importing or syncing can slow down, fail or stop until we catch up.
				</li>
				<li>
					A marketplace may decide that it doesn't allow tools like Teachouse, or may limit,
					suspend or close your marketplace account. That is its decision under its terms, and
					we can't promise it won't happen.
				</li>
				<li>
					We may pause or stop a connection to a marketplace at any time, including if the
					marketplace asks us to. If we stop one for good, we will tell you.
				</li>
				<li>
					Check your listings on the marketplace itself. The marketplace's own record is the one that
					counts.
				</li>
			</ul>

			<h2 id="changes-service">13. Changes and availability</h2>
			<p>
				<strong>In short:</strong> we keep Teachouse running and improve it over time, but we can't
				promise it will never be down.
			</p>
			<ul>
				<li>
					We improve Teachouse over time. Features may be added, changed and sometimes removed.
				</li>
				<li>
					Teachouse may be unavailable at times, for maintenance, updates or problems outside our
					control. We try to keep that short and to tell you ahead of planned work.
				</li>
				<li>
					If we remove something you pay for in a way that matters to you, tell us; we will look at
					a fair outcome, including a refund for the part you can no longer use.
				</li>
				<li>
					If we ever close Teachouse altogether, we will tell you at least 30 days ahead where we
					can, give you time to export your catalogue, and refund any unused part of a plan paid in
					advance.
				</li>
			</ul>

			<h2 id="privacy">14. Your information</h2>
			<p>
				<strong>In short:</strong> the Privacy Policy explains what we collect and why, under the New
				Zealand Privacy Act 2020.
			</p>
			<p>
				We handle personal information as the{' '}
				<a class="link" href="/privacy/">Privacy Policy</a> says, in line with the Privacy Act 2020.
				It forms part of these terms. If you publish information about other people in your
				resources, you are responsible for having the right to do so.
			</p>

			<h2 id="security">15. Keeping your account safe</h2>
			<p>
				<strong>In short:</strong> we protect our side; you protect your sign-in and your devices.
			</p>
			<ul>
				<li>
					We protect Teachouse with encryption and access controls, as the Privacy Policy describes.
					No system is perfectly secure.
				</li>
				<li>
					Use a strong password that you don't use anywhere else, or a passkey, and don't share it.
				</li>
				<li>
					Your marketplace sign-ins and imported files live on your own devices, so keep those
					devices locked and up to date.
				</li>
				<li>
					If a device is lost or you no longer use it, sign it out in Account → Account settings,
					under Device sign-ins.
				</li>
				<li>
					If you think someone else has got into your account, tell us straight away at{' '}
					<a class="link" href={`mailto:${supportEmail}`}>{supportEmail}</a>.
				</li>
			</ul>

			<h2 id="ending">16. Ending your account</h2>
			<p>
				<strong>In short:</strong> you can leave any time. We can close an account that breaks these
				terms, and where we can, we'll give you time to take your catalogue with you.
			</p>
			<ul>
				<li>
					You can stop using Teachouse at any time. Delete your account yourself at the foot of
					Account settings: it cancels any plan straight away, and we delete your account and
					catalogue as the Privacy Policy describes.
				</li>
				<li>
					Before you go, you can export your catalogue to a spreadsheet and download files you
					uploaded. Files you imported are already on your own devices.
				</li>
				<li>
					We may suspend or close your account if you seriously or repeatedly break these terms,
					misuse Teachouse, put other people or our systems at risk, or if the law requires it.
				</li>
				<li>
					Unless the breach is serious or the law stops us, we will tell you first, give you a
					chance to fix it, and give you at least 30 days to export your catalogue.
				</li>
				<li>
					Ending your Teachouse account doesn't remove your listings from any marketplace. Listings
					that are live stay live, and you manage them on the marketplace.
				</li>
				<li>
					Sections that by their nature should continue, such as 6, 17, 18, 19 and 21, continue after
					your account ends.
				</li>
			</ul>

			<h2 id="law">17. New Zealand consumer law</h2>
			<p>
				<strong>In short:</strong> New Zealand law gives consumers rights these terms can't take away.
				Business customers agree to contract out of some of them.
			</p>
			<ul>
				<li>
					If you are a consumer, you have rights under the Consumer Guarantees Act 1993 and the Fair
					Trading Act 1986 that can't be excluded. Nothing in these terms limits those rights.
				</li>
				<li>
					If you use Teachouse for the purposes of a business (selling resources on a marketplace
					usually is one), you agree that the Consumer Guarantees Act does not apply, and that
					sections 9, 12A, 13 and 14(1) of the Fair Trading Act do not apply, to the extent the law
					allows. We both agree this is fair and reasonable, because we are each in trade.
				</li>
			</ul>

			<h2 id="liability">18. What we're responsible for</h2>
			<p>
				<strong>In short:</strong> we provide Teachouse as it is, and our total liability is limited
				to what you paid us in the last 12 months, or NZ$100, whichever is greater.
			</p>
			<ul>
				<li>
					We provide Teachouse with reasonable care and skill. Apart from that, and except where the
					law says otherwise, it is provided "as is" and "as available", without promises that it
					will be uninterrupted, error-free or right for your purpose.
				</li>
				<li>
					We are not liable for what marketplaces do, including changes to their sites, the loss of
					a listing, or action against your marketplace account.
				</li>
				<li>
					We are not liable for lost sales, profits, income or opportunities, or for any indirect
					loss.
				</li>
				<li>
					Our total liability to you for everything to do with Teachouse is limited to the amount
					you paid us in the 12 months before the event that caused the claim, or NZ$100,
					whichever is greater.
				</li>
				<li>
					None of this limits liability that New Zealand law doesn't allow us to limit, including
					your rights under section 17, or liability for our fraud.
				</li>
			</ul>

			<h2 id="indemnity">19. What you're responsible for</h2>
			<p>
				<strong>In short:</strong> if your content or your breach of these terms gets us into trouble,
				you cover the reasonable cost.
			</p>
			<p>
				If someone makes a claim against us because of content you published through Teachouse, or
				because you broke these terms, the law or a marketplace's rules, you agree to cover our
				reasonable losses and costs from that claim. This doesn't apply to the extent we caused the
				problem ourselves, and we will tell you promptly about any such claim.
			</p>

			<h2 id="changes">20. Changes to these terms</h2>
			<p>
				<strong>In short:</strong> we'll tell you before a change that matters, and using Teachouse
				after it takes effect means you accept it.
			</p>
			<ul>
				<li>
					We may update these terms as Teachouse and the law change. The date at the top always
					shows the latest version.
				</li>
				<li>
					For a change that matters, we will email you and show a notice in the console at least 30
