---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/site.css';

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
/* A social card has to be a raster of a fixed size, which an SVG logo is not:
   every consumer of `og:image` resamples it and several refuse SVG outright.
   `public/images/og.png` is 1200 by 630, the logo centred on the kit's Cream,
   rendered from `public/brand/logo.svg` with resvg. */
const ogImage = new URL('/images/og.png', Astro.site);
---

<!doctype html>
<html lang="en" data-theme="light">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{/* The palette, decided before the stylesheet so the first paint is the
		    right colour. `teachouse.theme` is the console's own key, so a
		    signed-in seller who chose Dark there finds the marketing site dark
		    too; a visitor who chose nothing follows their machine. The
		    attribute on `<html>` is the no-script answer, and it is why
		    `site.css` pins `color-scheme` per theme. `tam-server` hashes every
		    inline block of the page it serves into the policy it sends
		    (`serving::inline_script_hashes`), so this needs no grant. */}
		<script is:inline>
			(function () {
				var chosen = null;
				try {
					chosen = localStorage.getItem('teachouse.theme');
				} catch (refused) {
					chosen = null;
				}
				if (chosen !== 'light' && chosen !== 'dark') {
					chosen = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				}
				document.documentElement.dataset.theme = chosen;
			})();
		</script>
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="preload" href="/fonts/inter-400-700-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/poppins-700-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/poppins-600-latin.woff2" as="font" type="font/woff2" crossorigin />
		<script is:inline src="/app-redirect.js"></script>
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<SiteHeader />
		<main id="main">
			<slot />
		</main>
		<SiteFooter />
	</body>
</html>
