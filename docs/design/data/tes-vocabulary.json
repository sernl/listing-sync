  "licences": {
    "field": "licence",
    "note": "RefdataStore.licences holds seven rows; GET /api/refdata/v2/licences returns the first five and omits the legacy pair. Price gates the write: a free resource picks among CC-BY, CC-BY-SA and CC-BY-ND (default CC-BY-SA) and a paid one is TES-PAID. TES-PAID-SCHOOL is the school tier. The editor rewrites TES-V1 and TES-V2 to CC-BY-SA on load, so both read back on older resources and neither is offered on write.",
    "options": {
      "CC-BY": {
        "type": "CC",
        "title": "Creative Commons Attribution 4.0 International licence",
        "paid": false,
        "publishable": true
      },
      "CC-BY-ND": {
        "type": "CC",
