  "curriculum": {
    "field": "curriculum",
    "options": [
      "none",
      "No curriculum",
      "American",
      "Australian",
      "Canadian",
      "English",
      "International",
      "Irish",
      "New Zealand",
      "Northern Irish",
      "Scottish",
      "Welsh",
      "Zambian"
    ],
    "note": "The `curriculum` scalar exists on the resource read model alongside `curriculumIds`, but the uploader writes orientation/framework/authority instead. This thirteen-line list is the orientation select as probe 04 transcribed it: it wrote the one synthetic option down twice, as `none` and `No curriculum`, and omitted `[rest of world]`. See curriculumCascade for what the store actually holds. 'American' is the likely US-inventory lever, unconfirmed."
  },
  "subjectsTopics": {
    "field": "categories:[{id}]",
    "api": "GET /taxonomy/v4/{country}/{id} (public JSON: id, country, parentId, path, leaf-depth)",
    "limit": "~10 subject/topic pairs per resource",
    "sample": {
      "1001595": "Aboriginal studies (root)",
      "1001586": "Aboriginal studies / Autonomy (topic)",
      "mathematicsTopics": {
        "1000448": "Algebra",
        "1000897": "Number",
        "1000903": "Geometry and measures",
        "1000977": "Data and statistics",
        "1000453": "Advanced decision",
        "1000452": "Advanced mechanics",
        "1000450": "Advanced pure",
        "1000451": "Advanced statistics"
      }
    },
    "mapTo": "Every taxonomy node carries a `mapTo`, which is Tes's own equivalence table between the national subject trees: GB 1000454 and US 5000454 both carry mapTo [91000454]. That is the right join key for a GB-to-US migration within Tes, and the right anchor for a crosswalk to another platform, because it is built once rather than per country.",
    "primaryCategory": "A resource posts `categories: [{id}]` plus exactly one `primaryCategory` id."
  },
