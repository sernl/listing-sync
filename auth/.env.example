# tam-auth environment. Copy to auth/.env for local development; .env is
# gitignored at the repository root.
#
# tam-auth owns platform-user identity and browser session only. It reaches
# Postgres solely as tam_auth, whose grants are confined to the auth schema,
# and it is never given the key-encryption key or the broker socket path.

# development relaxes two production requirements: RESEND_API_KEY and
# TURNSTILE_SECRET_KEY become optional, and the openAPI reference is mounted
# at /api/auth/reference. Absent, the mode is production.
TAM_AUTH_ENV=development

# Where the process listens. The browser never uses this address: it reaches
# /api/auth/* on the dashboard's origin, which a reverse proxy routes here.
TAM_AUTH_BIND=127.0.0.1
TAM_AUTH_PORT=8081

# The origin the browser sees, and the JWT issuer the Rust verifier pins.
# Standalone (no proxy) this is tam-auth's own address; behind the proxy it is
# the shared dashboard origin.
TAM_AUTH_BASE_URL=http://127.0.0.1:8081

# Signs sessions and encrypts the JWKS private half and stored OAuth tokens.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The tam_auth role, whose search_path is auth. Never the tam_app URL.
TAM_AUTH_DATABASE_URL=postgres://tam_auth:tam_auth_dev@127.0.0.1:5433/tam

# WebAuthn relying party. Defaults to the registrable domain of the
# TAM_AUTH_BASE_URL host (its last two labels: dash.teachouse.io gives
# teachouse.io, a loopback address stays itself); set explicitly under a
# two-label public suffix such as co.nz.
#TAM_AUTH_PASSKEY_RP_ID=
#TAM_AUTH_PASSKEY_RP_NAME=Listing Sync

# Email transport. Required in production. Absent, verification and
# password-reset links are logged to the console instead of sent.
#RESEND_API_KEY=
#TAM_AUTH_EMAIL_FROM=Listing Sync <no-reply@example.test>

# Cloudflare Turnstile. Required in production. Guards /sign-up/email,
# /sign-in/email and /request-password-reset; absent, those run unguarded.
#TURNSTILE_SECRET_KEY=

# Social providers. Each id and secret must be set together or not at all.
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#MICROSOFT_CLIENT_ID=
#MICROSOFT_CLIENT_SECRET=
#MICROSOFT_TENANT_ID=common

# The sign-up agreement. Every new account's two ticked boxes are written to
# tam-server's POST /internal/consent, fenced by the shared secret below; with
# either unset, or tam-server not running with --consent-secret-file holding
# the same secret, every sign-up is refused (the account is removed again).
# `just dev-all` hands tam-server this secret from here.
TAM_AUTH_CONSENT_URL=http://127.0.0.1:8080/internal/consent
# Also fences GET /internal/address/{subject}. `just auth-env` fills it in.
TAM_AUTH_INTERNAL_SECRET=
# The sign-up abuse screen (throwaway email domains, too many accounts from one
# network, banned identities), fenced by the same secret. Defaults to the
# consent URL with /internal/consent replaced by /internal/abuse/screen. When
# it cannot be reached, sign-ups are let through and the miss is logged.
#TAM_AUTH_ABUSE_SCREEN_URL=http://127.0.0.1:8080/internal/abuse/screen
