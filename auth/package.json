{
  "name": "tam-auth",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/server.ts",
    "start": "node src/server.ts",
    "check": "tsc --noEmit",
    "test": "node src/tests-present.ts && node --test src/log.test.ts src/template.test.ts",
    "ddl": "node --env-file-if-exists=.env src/generate-ddl.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.2",
    "better-auth": "^1.7.2",
    "kysely": "^0.28.17",
    "pg": "^8.23.0",
    "resend": "^6.25.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  }
}
