{
  "db_name": "PostgreSQL",
  "query": "WITH due AS ( SELECT campaign_id, user_id FROM mail_campaign_recipient WHERE status = 'queued' AND next_attempt_at <= $1 AND (leased_until IS NULL OR leased_until <= $1) ORDER BY next_attempt_at, campaign_id, user_id LIMIT 1 FOR UPDATE SKIP LOCKED) UPDATE mail_campaign_recipient r SET leased_until = $2, attempts = r.attempts + 1, updated_at = $1 FROM due, mail_campaign c, app_user u WHERE r.campaign_id = due.campaign_id AND r.user_id = due.user_id AND c.id = r.campaign_id AND u.id = r.user_id RETURNING r.campaign_id, r.user_id, r.auth_subject, r.org_name, r.plan, r.attempts, c.subject, c.body_html, c.link_url, c.link_label, c.audience, u.marketing_opt_out, u.marketing_token",
