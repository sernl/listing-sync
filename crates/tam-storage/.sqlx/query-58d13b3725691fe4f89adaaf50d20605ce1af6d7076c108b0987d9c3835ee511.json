{
  "db_name": "PostgreSQL",
  "query": "SELECT e.product_lo, e.product_hi, e.layer, e.polarity, e.measure, e.unit, e.observed_in FROM duplicate_evidence e JOIN duplicate_verdict v ON v.org_id = e.org_id AND v.product_lo = e.product_lo AND v.product_hi = e.product_hi WHERE e.org_id = $1 AND v.verdict = 'parked' AND ($2::uuid IS NULL OR v.run_id = $2) ORDER BY e.position",
