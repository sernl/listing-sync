{
  "db_name": "PostgreSQL",
  "query": "SELECT d.id, d.name, d.last_seen_at, d.stream_polled_at FROM device_library_holding h JOIN device d ON d.org_id = h.org_id AND d.id = h.device_id WHERE h.org_id = $1 AND h.hash = $2 AND d.revoked_at IS NULL ORDER BY d.stream_polled_at DESC NULLS LAST, d.last_seen_at DESC, d.id",
