  "query": "SELECT id, request_idempotency_key AS \"key!\", sync_request_id, import_run_id, actor_kind, actor_id, EXISTS (SELECT 1 FROM job_item item WHERE item.org_id = job.org_id AND item.job_id = job.id) AS \"has_items!\", EXISTS (SELECT 1 FROM import_run run WHERE run.org_id = job.org_id AND run.anchor_job = job.id) AS \"anchors_import!\" FROM job WHERE job.org_id = $1 AND job.request_idempotency_key = ANY($2) ORDER BY job.id FOR UPDATE",
