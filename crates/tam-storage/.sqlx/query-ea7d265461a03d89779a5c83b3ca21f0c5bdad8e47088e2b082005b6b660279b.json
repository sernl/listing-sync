  "query": "SELECT h.hash, h.device_id, d.name AS device_name, d.stream_polled_at FROM device_library_holding h JOIN device d ON d.org_id = h.org_id AND d.id = h.device_id WHERE h.org_id = $1 AND d.revoked_at IS NULL AND h.hash = ANY ($2) ORDER BY h.hash, d.name",
