  "query": "SELECT id, title, price_kind, price_minor_units, price_currency, created_at, updated_at, ARRAY(SELECT l.name FROM product_label pl JOIN label l ON l.org_id = pl.org_id AND l.id = pl.label_id WHERE pl.org_id = product.org_id AND pl.product_id = product.id ORDER BY lower(l.name)) AS \"labels!\" FROM product WHERE org_id = $1 AND deleted_at IS NULL AND ($2::timestamptz IS NULL OR (created_at, id) > ($2, $3)) ORDER BY created_at, id LIMIT $4",
