  "query": "SELECT f.id, f.role, f.kind, f.hash, b.byte_len AS \"byte_len!\", f.scan_state, f.scan_signature, f.scanned_at, f.scan_failure_code FROM product_file f JOIN blob b ON b.org_id = f.org_id AND b.hash = f.hash WHERE f.org_id = $1 AND f.product_id = $2 AND f.deleted_at IS NULL ORDER BY f.position",
