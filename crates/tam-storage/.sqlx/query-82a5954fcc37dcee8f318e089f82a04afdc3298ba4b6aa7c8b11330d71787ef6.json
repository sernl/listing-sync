{
  "db_name": "PostgreSQL",
  "query": "SELECT r.tick, r.product_id, r.inventory, r.state, r.job_id, r.reason, COALESCE(p.title, '') AS \"title!\" FROM schedule_run r LEFT JOIN product p ON p.org_id = r.org_id AND p.id = r.product_id WHERE r.org_id = $1 AND r.schedule_id = $2 ORDER BY r.tick DESC, r.inventory, p.title LIMIT $3",
