{
  "db_name": "PostgreSQL",
  "query": "SELECT m.id AS mapping_id, m.product_id, m.sever_generation, m.binding_state, m.lifecycle_state, m.remote_id_kind, m.remote_url, m.remote_numeric_id, COALESCE(f.hash, f.observed_hash) AS \"hash!\" FROM mapping m JOIN product_file f ON f.org_id = m.org_id AND f.product_id = m.product_id WHERE m.org_id = $1 AND m.inventory = $2 AND m.id = ANY($3) AND f.role = 'payload' AND f.deleted_at IS NULL ORDER BY m.id, f.position",
