  "query": "SELECT pf.kind, pf.hash, b.byte_len AS \"byte_len?\", pf.scan_state, pf.scan_signature, pf.scanned_at, pf.scan_failure_code, pf.source_marketplace, pf.source_connection, pf.source_resource, pf.source_entry, pf.observed_hash, pf.observed_byte_len, pf.observed_by_device, pf.observed_at, pf.asserted_scan_state, pf.asserted_scan_signature, pf.asserted_scanned_at, pf.asserted_scan_failure_code, pf.payload_file_name, pf.payload_content_type FROM product_file pf LEFT JOIN blob b ON b.org_id = pf.org_id AND b.hash = pf.hash WHERE pf.org_id = $1 AND pf.id = $2 AND pf.deleted_at IS NULL",
