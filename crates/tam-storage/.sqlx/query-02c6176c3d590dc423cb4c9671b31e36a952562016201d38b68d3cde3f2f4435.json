{
  "db_name": "PostgreSQL",
  "query": "SELECT m.id AS mapping_id, m.product_id, m.sever_generation, f.hash FROM mapping m JOIN product_file f ON f.org_id = m.org_id AND f.product_id = m.product_id WHERE m.org_id = $1 AND m.inventory = $2 AND m.id = ANY($3) AND f.role = 'payload' AND f.deleted_at IS NULL ORDER BY m.id, f.position",
