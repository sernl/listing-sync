  "query": "SELECT id, org_id, provider_event_id, kind, amount_cents, currency, provider_object_id, charge_id, payment_intent_id, invoice_id, customer_id, status, reason, occurred_at, created_at FROM payment_event WHERE kind = 'payment_succeeded' AND occurred_at >= $3 AND (org_id = $1 OR customer_id = ANY($2)) ORDER BY occurred_at DESC, id LIMIT 100",
