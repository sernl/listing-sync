  "query": "SELECT u.id, u.email, u.auth_subject, u.created_at, o.id AS \"org_id\", o.name AS \"org_name\", o.slug AS \"org_slug\" FROM app_user u JOIN organisation o ON o.id = u.org_id WHERE $1::timestamptz IS NULL OR (date_trunc('milliseconds', u.created_at), u.id) < ($1, $2::uuid) ORDER BY date_trunc('milliseconds', u.created_at) DESC, u.id DESC LIMIT $3",
