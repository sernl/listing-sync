  "query": "SELECT org_id, id, title, price_kind, price_minor_units, price_currency, created_at, updated_at FROM product WHERE org_id = $1 AND deleted_at IS NULL AND ($2::timestamptz IS NULL OR (created_at, id) > ($2, $3)) AND ($5::text IS NULL OR EXISTS ( SELECT 1 FROM product_label pl JOIN label l ON l.org_id = pl.org_id AND l.id = pl.label_id WHERE pl.org_id = product.org_id AND pl.product_id = product.id AND lower(l.name) = lower($5))) ORDER BY created_at, id LIMIT $4",
