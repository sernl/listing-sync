{
  "db_name": "PostgreSQL",
  "query": "SELECT r.schedule_id, r.tick, r.inventory, s.name, COUNT(*) FILTER (WHERE r.state = 'sent') AS \"sent!\" FROM schedule_run r JOIN schedule s ON s.org_id = r.org_id AND s.id = r.schedule_id WHERE r.org_id = $1 AND ($2::timestamptz IS NULL OR r.tick < $2) GROUP BY r.schedule_id, r.tick, r.inventory, s.name ORDER BY r.tick DESC LIMIT $3",
