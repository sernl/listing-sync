  "query": "SELECT r.org_id, r.id, r.requested_by, u.email AS \"email?\", r.name, r.url, r.reason, r.created_at FROM marketplace_request r LEFT JOIN app_user u ON u.id = r.requested_by WHERE ($2::timestamptz IS NULL OR (r.created_at, r.id) < ($2, $3)) ORDER BY r.created_at DESC, r.id DESC LIMIT $1",
