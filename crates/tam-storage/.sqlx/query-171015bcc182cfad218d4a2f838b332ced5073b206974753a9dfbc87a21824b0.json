{
  "db_name": "PostgreSQL",
  "query": "SELECT m.product_id, m.inventory, p.title FROM mapping m JOIN product p ON p.org_id = m.org_id AND p.id = m.product_id WHERE m.org_id = $1 AND m.binding_state = 'bound' AND p.deleted_at IS NULL ORDER BY p.title, p.id, m.inventory",
