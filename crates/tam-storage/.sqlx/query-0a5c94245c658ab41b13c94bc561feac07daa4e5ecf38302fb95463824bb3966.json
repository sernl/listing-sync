{
  "db_name": "PostgreSQL",
  "query": "SELECT id, mapping_id, state, outcome, failure_code, failure_detail, blocked_on, attempt_count, created_at, settled_at FROM job_item WHERE org_id = $1 AND job_id = $2 AND EXISTS (SELECT 1 FROM job j WHERE j.org_id = job_item.org_id AND j.id = job_item.job_id AND j.deletion_state IS DISTINCT FROM 'deleted') AND ($3::timestamptz IS NULL OR (created_at, id) > ($3, $4)) AND ($6::text IS NULL OR outcome = $6) ORDER BY created_at, id LIMIT $5",
